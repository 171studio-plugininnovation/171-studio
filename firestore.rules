rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isMaster() {
      return request.auth != null && (
        request.auth.token.email.lower() == '171studiomessina@gmail.com' ||
        request.auth.token.email.lower() == '171studio@gmail.com' ||
        request.auth.token.email.lower() == 'vkrealhakiesake@gmail.com'
      );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Public CMS settings (site texts, playlists, and plugin catalog)
    match /settings/cms {
      allow read: if true;
      allow write: if isMaster() || isSignedIn();
    }

    // Bookings collection: allow creation by clients/guests; allow read/update for management
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // User accounts collection: multi-device profile sync
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if isMaster();
    }

    // Album orders: "The God Cypher" physical & digital purchases
    match /album_orders/{orderId} {
      allow read, create, update, delete: if true;
    }

    // Client deliveries & stems
    match /client_deliveries/{deliveryId} {
      allow read, create, update, delete: if true;
    }

    // Dedicated voucher redemptions audit
    match /voucher_redemptions/{redemptionId} {
      allow read, create, update: if true;
      allow delete: if isMaster();
    }

    // Plugin bug reports
    match /plugin_bug_reports/{reportId} {
      allow read, create: if true;
      allow update, delete: if isMaster() || isSignedIn();
    }

    // Activity Audit Log (activities tracked on site)
    match /activities/{activityId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Automated emails outbox & logs
    match /emails/{emailId} {
      allow read, create, update, delete: if true;
    }

    // Default deny any unspecified collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
